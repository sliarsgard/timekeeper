<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:vm="using:Timekeeper.App.ViewModels"
        xmlns:v="using:Timekeeper.App.Views"
        x:Class="Timekeeper.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Timekeeper"
        Icon="/Assets/timekeeper.ico"
        Width="1340" Height="880"
        MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:ActivityPageViewModel">
            <v:ActivityView />
        </DataTemplate>
        <DataTemplate DataType="vm:TimesheetPageViewModel">
            <v:TimesheetView />
        </DataTemplate>
        <DataTemplate DataType="vm:ClientsPageViewModel">
            <v:ClientsView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsPageViewModel">
            <v:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="236,*">
        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="14,0,14,16">
                <Border DockPanel.Dock="Top"
                        Height="60"
                        Background="Transparent"
                        chrome:WindowDecorationProperties.ElementRole="TitleBar">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Grid Width="26" Height="26">
                            <Ellipse Fill="{DynamicResource AccentBrush}" />
                            <Path Stroke="{DynamicResource OnAccentBrush}"
                                  StrokeThickness="2.4"
                                  StrokeLineCap="Round"
                                  Data="M13,13 L13,6.5 M13,13 L18.2,16.2" />
                        </Grid>
                        <TextBlock Text="Timekeeper" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Tracking status -->
                <Border DockPanel.Dock="Top" Classes="card" Padding="14,12" Margin="0,4,0,18" CornerRadius="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource AccentBrush}" Classes="pulse" IsVisible="{Binding IsTracking}" />
                                    <Ellipse Fill="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsTracking}" />
                                </Grid>
                                <TextBlock Text="{Binding TrackingStatus}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding TodayActive}" Classes="muted" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="ghost icon"
                                Command="{Binding TogglePauseCommand}"
                                ToolTip.Tip="{Binding PauseTooltip}">
                            <TextBlock Classes="icon" Text="{Binding PauseGlyph}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Update + version -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="10">
                    <Border Classes="card appear" Padding="14" CornerRadius="12" IsVisible="{Binding IsUpdateReady}"
                            BorderBrush="{DynamicResource AccentBrush}">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding UpdateVersion, StringFormat='Version {0} är klar'}" FontWeight="SemiBold" />
                                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Appen startar om på några sekunder." />
                            </StackPanel>
                            <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Command="{Binding RestartToUpdateCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="icon" Text="&#xE72C;" FontSize="13" />
                                    <TextBlock Text="Uppdatera nu" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="muted" FontSize="11" Text="{Binding VersionText}" Margin="8,0,0,0" />
                </StackPanel>

                <ListBox Classes="nav" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PageViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Classes="icon" Text="{Binding Icon}" FontSize="15" />
                                <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page -->
        <Grid Grid.Column="1" RowDefinitions="44,*">
            <Border Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar" />
            <!-- Caption buttons drawn to match the app; the User role lets them take clicks inside the title bar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Classes="caption" chrome:WindowDecorationProperties.ElementRole="User" Click="OnMinimizeClick" ToolTip.Tip="Minimera">
                    <TextBlock Classes="icon" Text="&#xE921;" FontSize="10" />
                </Button>
                <Button Classes="caption" chrome:WindowDecorationProperties.ElementRole="User" Click="OnMaximizeClick" ToolTip.Tip="Maximera">
                    <TextBlock Classes="icon" FontSize="10" Text="{Binding $parent[Window].WindowState, Converter={x:Static v:MainWindow.MaximizeGlyph}}" />
                </Button>
                <Button Classes="caption close" chrome:WindowDecorationProperties.ElementRole="User" Click="OnCloseClick" ToolTip.Tip="Stäng">
                    <TextBlock Classes="icon" Text="&#xE8BB;" FontSize="10" />
                </Button>
            </StackPanel>
            <TransitioningContentControl Grid.Row="1" Content="{Binding SelectedPage}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.18" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Grid>
    </Grid>
</Window>
