<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Timekeeper.App.ViewModels"
             xmlns:v="using:Timekeeper.App.Views"
             x:Class="Timekeeper.App.Views.TimesheetView"
             x:DataType="vm:TimesheetPageViewModel">
    <Grid Margin="32,4,32,28" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <v:DayHeader DataContext="{Binding Day}" Tag="TIDSLOGG" Margin="0,0,0,22" />

        <!-- Error -->
        <Border Grid.Row="1" Classes="pill danger appear" CornerRadius="10" Padding="14,10" Margin="0,0,0,14"
                IsVisible="{Binding HasError}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Classes="icon" Text="&#xE783;" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="ghost icon" Width="28" Height="28" Command="{Binding DismissErrorCommand}">
                    <TextBlock Classes="icon" Text="&#xE711;" FontSize="10" />
                </Button>
            </Grid>
        </Border>

        <!-- Progress while the AI works -->
        <Border Grid.Row="2" Classes="card appear" Margin="0,0,0,14" IsVisible="{Binding IsGenerating}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Classes="h2" Text="Skapar förslag" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding ProgressText}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="Avbryt" Command="{Binding CancelCommand}" VerticalAlignment="Center" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" Value="{Binding Progress}" Maximum="100">
                    <ProgressBar.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Value" Duration="0:0:0.3" Easing="CubicEaseOut" />
                        </Transitions>
                    </ProgressBar.Transitions>
                </ProgressBar>
            </Grid>
        </Border>

        <!-- Empty state -->
        <Border Grid.Row="3" Classes="card appear" IsVisible="{Binding ShowEmptyState}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="420">
                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                    <TextBlock Classes="icon" Text="&#xE945;" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Classes="h2" Text="Ingen tidslogg för dagen ännu" HorizontalAlignment="Center" />
                <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center"
                           Text="AI:n går igenom dagens aktivitet, känner igen kunderna och föreslår tidsposter med kommentarer som du sedan justerar." />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding ModelStatus}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button Classes="primary" Command="{Binding GenerateCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="&#xE945;" FontSize="13" />
                            <TextBlock Text="Skapa förslag" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Content="Lägg till manuellt" Command="{Binding AddEntryCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Entries -->
        <Border Grid.Row="3" Classes="card appear" Padding="0" IsVisible="{Binding HasEntries}">
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="2*,1.7*,96,2.6*,76" Margin="20,14,20,8">
                    <TextBlock Classes="label" Text="Kund" />
                    <TextBlock Grid.Column="1" Classes="label" Text="Aktivitet" Margin="10,0,0,0" />
                    <TextBlock Grid.Column="2" Classes="label" Text="Timmar" Margin="10,0,0,0" />
                    <TextBlock Grid.Column="3" Classes="label" Text="Kommentar" Margin="10,0,0,0" />
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Entries}" Margin="12,0,12,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimesheetEntryViewModel">
                                <Border CornerRadius="10" Padding="8,6" Margin="0,2" Classes="appear">
                                    <Grid ColumnDefinitions="2*,1.7*,96,2.6*,76">
                                        <AutoCompleteBox Text="{Binding Client}"
                                                         ItemsSource="{Binding $parent[ItemsControl].((vm:TimesheetPageViewModel)DataContext).ClientNames}"
                                                         FilterMode="ContainsOrdinal"
                                                         PlaceholderText="Kund" />
                                        <ComboBox Grid.Column="1" Margin="10,0,0,0"
                                                  ItemsSource="{Binding $parent[ItemsControl].((vm:TimesheetPageViewModel)DataContext).Activities}"
                                                  SelectedItem="{Binding Activity}" />
                                        <NumericUpDown Grid.Column="2" Margin="10,0,0,0" Value="{Binding Hours}"
                                                       Increment="0.25" Minimum="0" Maximum="24" FormatString="0.00"
                                                       ShowButtonSpinner="False" HorizontalContentAlignment="Right" />
                                        <TextBox Grid.Column="3" Margin="10,0,0,0" Text="{Binding Comment}" PlaceholderText="Vad gjordes?" />
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                                            <Border Classes="pill warning" IsVisible="{Binding IsUncertain}" VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding ConfidenceTooltip}" Padding="7,4">
                                                <TextBlock Classes="icon" Text="&#xE7BA;" FontSize="12" />
                                            </Border>
                                            <Button Classes="ghost icon"
                                                    Command="{Binding $parent[ItemsControl].((vm:TimesheetPageViewModel)DataContext).DeleteEntryCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Ta bort raden">
                                                <TextBlock Classes="icon" Text="&#xE74D;" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="4,16,0,0" IsVisible="{Binding HasEntries}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="Totalt (utan intern tid)" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Total}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost" Command="{Binding AddEntryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" Text="&#xE710;" FontSize="12" />
                        <TextBlock Text="Lägg till rad" />
                    </StackPanel>
                </Button>
                <Button Classes="ghost" Command="{Binding GenerateCommand}" ToolTip.Tip="Ersätter dagens rader med ett nytt förslag">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" Text="&#xE945;" FontSize="12" />
                        <TextBlock Text="Nytt förslag" />
                    </StackPanel>
                </Button>
                <Button Classes="primary" Click="OnCopyClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" Text="&#xE8C8;" FontSize="13" />
                        <Panel>
                            <TextBlock Text="Kopiera för Blikk" IsVisible="{Binding !JustCopied}" />
                            <TextBlock Text="Kopierat!" IsVisible="{Binding JustCopied}" />
                        </Panel>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
